# Modelo de configuracao por variavel de ambiente.
#
# Copie para .env e preencha. O arquivo .env esta no .gitignore e NAO deve ser
# versionado -- e ele que guarda a senha real do banco.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a && ./mvnw spring-boot:run
#
# Sem nenhuma dessas variaveis definidas, a aplicacao usa os padroes do
# application.yml, que apontam para o PostgreSQL do docker-compose.yml.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------

# Local (docker-compose) -- este e o padrao embutido na aplicacao:
DB_URL=jdbc:postgresql://localhost:5432/destinos
DB_USERNAME=destinos
DB_PASSWORD=destinos

# Neon (banco online, free tier). A string de conexao aparece no painel do
# projeto em "Connection Details"; converta para o formato JDBC como abaixo.
# O sslmode=require nao e opcional: o Neon so aceita conexao com TLS.
#
# DB_URL=jdbc:postgresql://ep-nome-do-projeto-123456.sa-east-1.aws.neon.tech/destinos?sslmode=require
# DB_USERNAME=seu_usuario
# DB_PASSWORD=sua_senha
#
# Dica: o Neon hiberna o compute depois de alguns minutos sem uso. A primeira
# requisicao seguinte leva alguns segundos enquanto ele acorda -- e o motivo do
# connection-timeout folgado no application.yml, nao um bug.

# ---------------------------------------------------------------------------
# Usuarios de acesso criados na primeira inicializacao
#
# Se ja existirem no banco, estes valores sao ignorados: a carga inicial nunca
# sobrescreve senha de usuario existente. Para trocar a senha de um usuario que
# ja existe, apague-o do banco e reinicie, ou faca um UPDATE com o hash novo.
# ---------------------------------------------------------------------------

APP_ADMIN_USERNAME=admin
APP_ADMIN_SENHA=defina-uma-senha-forte-aqui

APP_USER_USERNAME=viajante
APP_USER_SENHA=defina-outra-senha-forte-aqui

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------

# SERVER_PORT=8080
# DB_POOL_MAX=5
